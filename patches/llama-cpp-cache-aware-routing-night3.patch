+
+void llama_moe_route_stats_op(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata) {
+    GGML_UNUSED(dst);
+    GGML_UNUSED(nth);
+    GGML_UNUSED(userdata);
+    moe_cache * mc = g_cache;
+    if (!mc || ith != 0) {
+        return;
+    }
+    GGML_ASSERT(a->type == GGML_TYPE_F32 && a->ne[0] == 1);
+
+    // a: [1, n_expert_used, n_tokens], the 0-based unbiased rank of each selected
+    // expert; a rank >= n_expert_used is an expert the bonus pulled into the top-k
+    const int64_t k = a->ne[1];
+    uint64_t sel = 0, changed = 0, swaps = 0, rank = 0;
+    for (int64_t t = 0; t < a->ne[2]; ++t) {
+        uint64_t sw = 0;
+        for (int64_t i = 0; i < k; ++i) {
+            const float r = *(const float *) ((const char *) a->data + i*a->nb[1] + t*a->nb[2]);
+            if (r >= (float) k) {
+                sw++;
+                rank += (uint64_t) r + 1;
+            }
+        }
+        sel++;
+        changed += sw > 0;
+        swaps   += sw;
+    }
+
+    std::lock_guard<std::mutex> lock(mc->mtx);
+    mc->n_route_sel     += sel;
+    mc->n_route_changed += changed;
+    mc->n_route_swaps   += swaps;
+    mc->n_route_rank    += rank;
+}

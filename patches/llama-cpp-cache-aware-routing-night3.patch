+            mc->n_route_swaps ? (double) mc->n_route_rank/mc->n_route_swaps : 0.0,
+            ds, ds ? 100.0*dc/ds : 0.0, dw, dw ? (double) dr/dw : 0.0);
+    mc->rp_route_sel = mc->n_route_sel; mc->rp_route_changed = mc->n_route_changed;

+// one cache-aware routing line: the interval since the last line and the run total
+// (caller holds mc->mtx). Silent until --moe-cache-route-bonus has changed a graph.
+static void route_stats_report(moe_cache * mc) {
+    if (mc->n_route_sel == 0) {
+        return;
+    }
+    const uint64_t ds = mc->n_route_sel - mc->rp_route_sel, dc = mc->n_route_changed - mc->rp_route_changed;
+    const uint64_t dw = mc->n_route_swaps - mc->rp_route_swaps, dr = mc->n_route_rank - mc->rp_route_rank;
